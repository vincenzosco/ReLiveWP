{
  "name": "@relivewp/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared site chrome and Metro styling for the ReLiveWP web apps",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./icons/*": "./icons/*",
    "./logo.svg": "./logo.svg"
  },
  "files": [
    "dist",
    "styles",
    "icons",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.7.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dialog-polyfill": "^0.5.6"
  }
}
